{
  "rules": {
    "admin": {
      ".read": "auth != null",
      ".write": false
    },
    "users": {
      ".read": "auth != null",
      "$uid": {
        ".write": "$uid === auth.uid"
      }
    },
    "queries": {
      ".read": "auth != null",
      "$queryId": {
        ".write": "!data.exists()"
      }
    }
  }
}
